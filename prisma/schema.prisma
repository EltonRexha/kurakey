// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  firstName     String
  lastName      String?
  username      String        @unique
  password      String?
  email         String        @unique
  emailVerified DateTime?
  image         String?
  isActive      Boolean       @default(true)
  coinBalance   Int           @default(500)
  xp            Int           @default(0)
  sessions      Session[]
  achievements  Achievement[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  Chest           Chest[]
  coinTransaction CoinTransaction[]
  userRoom        UserRoom[]
  invitedFriends  FriendInvite[]    @relation("inviter")
  invitedBy       FriendInvite?     @relation("invitee")
  sentTrades      Trade[]           @relation("sender")
  receivedTrades  Trade[]           @relation("receiver")
  Notification    Notification[]
  UserCoinPackage UserCoinPackage[]
  Bundle          Bundle[]
  StripePayments  StripePayments[]
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id              String         @id @default(cuid())
  name            String
  category        RoomCategory
  rarity          Rarity
  isSecret        Boolean        @default(false)
  previewImageUrl String
  assetUrl        String
  UserRoom        UserRoom[]
  Notification    Notification[]

  @@unique([name, category])
}

model UserRoom {
  id                   String   @id @default(cuid())
  user                 User     @relation(fields: [userId], references: [id])
  userId               String
  room                 Room     @relation(fields: [roomId], references: [id])
  roomId               String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  senderTradeOffered   Trade[]  @relation("tradeSenderRooms")
  receiverTradeOffered Trade[]  @relation("tradeReceiverRooms")

  @@index([userId])
  @@index([roomId])
}

model ChestType {
  id                  String                @id @default(cuid())
  name                String                @unique
  price               Int
  xpGain              Int
  Chests              Chest[]
  ChestDropRate       ChestDropRate[]
  BundleTypeChestType BundleTypeChestType[]
  CoinTransaction     CoinTransaction[]
  Notification        Notification[]
}

model ChestDropRate {
  id          String    @id @default(cuid())
  chestType   ChestType @relation(fields: [chestTypeId], references: [id])
  chestTypeId String
  rarity      Rarity
  chance      Float // % of chance

  @@unique([chestTypeId, rarity])
}

model Chest {
  id                   String    @id @default(cuid())
  type                 ChestType @relation(fields: [chestTypeId], references: [id])
  User                 User      @relation(fields: [userId], references: [id])
  userId               String
  opened               Boolean   @default(false)
  senderTradeOffered   Trade[]   @relation("tradeSenderChests")
  receiverTradeOffered Trade[]   @relation("tradeReceiverChests")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  chestTypeId          String

  @@index([userId])
  @@index([chestTypeId])
}

model BundleType {
  id                  String                @id @default(cuid())
  name                String                @unique
  price               Float // Price in real dollars
  coinAmount          Int
  stripePriceId       String?
  Bundle              Bundle[]
  BundleTypeChestType BundleTypeChestType[]
  StripePayments      StripePayments[]
}

model BundleTypeChestType {
  id String @id @default(cuid())

  Bundle       BundleType @relation(fields: [bundleTypeId], references: [id])
  bundleTypeId String
  ChestType    ChestType  @relation(fields: [chestTypeId], references: [id])
  chestTypeId  String
  amount       Int //amount of chests being stored

  @@unique([bundleTypeId, chestTypeId])
  @@index([bundleTypeId])
  @@index([chestTypeId])
}

model Bundle {
  id           String     @id @default(cuid())
  type         BundleType @relation(fields: [bundleTypeId], references: [id])
  User         User       @relation(fields: [userId], references: [id])
  bundleTypeId String
  userId       String

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  CoinTransaction   CoinTransaction? @relation(fields: [coinTransactionId], references: [id])
  coinTransactionId String?

  @@index([userId])
  @@index([bundleTypeId])
}

model StripePayments {
  id          String              @id @default(cuid())
  status      StripePaymentStatus
  userId      String
  user        User                @relation(fields: [userId], references: [id])
  coinPackage CoinPackage?        @relation(fields: [coinPackageId], references: [id])
  bundleType  BundleType?         @relation(fields: [bundleTypeId], references: [id])
  sessionId   String              @unique

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  coinPackageId String?
  StripeEvents  StripeEvents[]
  bundleTypeId  String?

  @@index([userId])
}

model StripeEvents {
  id               String         @id @default(cuid())
  eventId          String         @unique
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  StripePayments   StripePayments @relation(fields: [stripePaymentsId], references: [id])
  stripePaymentsId String
}

model Trade {
  id String @id @default(cuid())

  sender            User       @relation("sender", fields: [senderId], references: [id])
  senderId          String
  receiver          User       @relation("receiver", fields: [receiverId], references: [id])
  receiverId        String
  senderRooms       UserRoom[] @relation("tradeSenderRooms")
  receiverRooms     UserRoom[] @relation("tradeReceiverRooms")
  senderChests      Chest[]    @relation("tradeSenderChests")
  receiverChests    Chest[]    @relation("tradeReceiverChests")
  senderReady       Boolean    @default(false)
  receiverReady     Boolean    @default(false)
  senderConfirmed   Boolean    @default(false)
  receiverConfirmed Boolean    @default(false)

  status       TradeStatus    @default(PENDING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  Notification Notification[]

  @@index([senderId])
  @@index([receiverId])
  @@index([status])
}

model CoinTransaction {
  id              String              @id @default(cuid())
  user            User                @relation(fields: [userId], references: [id])
  userId          String
  amount          Int
  type            CoinTransactionType
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  UserCoinPackage UserCoinPackage?
  bundle          Bundle[]
  chestType       ChestType?          @relation(fields: [chestTypeId], references: [id])
  chestTypeId     String?

  @@index([userId])
  @@index([chestTypeId])
}

model FriendInvite {
  id        String @id @default(cuid())
  inviter   User   @relation("inviter", fields: [inviterId], references: [id])
  inviterId String
  invitee   User   @relation("invitee", fields: [userId], references: [id])
  userId    String @unique
  code      String @unique
}

model Notification {
  id            String           @id @default(cuid())
  user          User             @relation(fields: [userId], references: [id])
  userId        String
  message       String
  shown         Boolean          @default(false)
  chestType     ChestType?       @relation(fields: [chestTypeId], references: [id])
  room          Room?            @relation(fields: [roomId], references: [id])
  achievement   Achievement?     @relation(fields: [achievementId], references: [id])
  trade         Trade?           @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  xpAmount      Int?
  coinAmount    Int?
  type          NotificationType
  isRead        Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  chestTypeId   String?
  roomId        String?
  achievementId String?
  tradeId       String?

  @@index([userId])
  @@index([type])
  @@index([tradeId])
  @@index([isRead])
}

model UserCoinPackage {
  id String @id @default(cuid())

  user              User            @relation(fields: [userId], references: [id])
  userId            String
  package           CoinPackage     @relation(fields: [coinPackageId], references: [id])
  coinPackageId     String
  transaction       CoinTransaction @relation(fields: [coinTransactionId], references: [id])
  coinTransactionId String          @unique

  @@index([userId])
  @@index([coinPackageId])
  @@index([coinTransactionId])
}

model CoinPackage {
  id              String            @id @default(cuid())
  price           Int
  stripePriceId   String?
  baseCoins       Int
  bonusCoins      Int
  name            String            @unique
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  UserCoinPackage UserCoinPackage[]
  StripePayments  StripePayments[]
}

model Achievement {
  id            String         @id @default(cuid())
  image         String
  type          String         @unique
  unlockMessage String
  users         User[]
  Notification  Notification[]
}

enum StripePaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum NotificationType {
  ROOM_RECEIVED
  CHEST_RECEIVED
  XP_GAIN
  FRIEND_REQUEST
  TRADE_INVITE
  TRADE_COMPLETED
  ACHIEVEMENT
  COIN_RECEIVED
  OTHER
}

enum TradeStatus {
  PENDING
  COMPLETED
}

enum CoinTransactionType {
  PURCHASE
  REWARD
  GIFT
  OPEN_CHEST
}

enum Rarity {
  UNCOMMON
  COMMON
  RARE
  EPIC
  LEGENDARY
  SECRET
}

enum RoomCategory {
  ZEN
  NEON
  MYSTIC
  VOID
  RAIN
  INFERNO
  COSMIC
  URBAN
  SANCTUM
  ASCENSION
  SECRET
  ANIME
}
