// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  firstName     String
  lastName      String?
  username      String        @unique
  password      String?
  email         String        @unique
  emailVerified DateTime?
  image         String?
  coinBalance   Int           @default(500)
  sessions      Session[]
  achievements  Achievement[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  Chest           Chest[]
  coinTransaction CoinTransaction[]
  userRoom        UserRoom[]
  invitedFriends  FriendInvite[]    @relation("inviter")
  invitedBy       FriendInvite?     @relation("invitee")
  sentTrades      Trade[]           @relation("sender")
  receivedTrades  Trade[]           @relation("receiver")
  Notification    Notification[]
  UserCoinPackage UserCoinPackage[]
  Bundle          Bundle[]
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id              String       @id @default(cuid())
  name            String
  category        RoomCategory
  rarity          Rarity
  isSecret        Boolean      @default(false)
  previewImageUrl String
  assetUrl        String
  UserRoom        UserRoom[]

  @@unique([name, category])
}

model UserRoom {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id])
  userId          String
  room            Room     @relation(fields: [roomId], references: [id])
  roomId          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  offeredInTrades Trade[]  @relation("tradeSenderRooms")
  wantedInTrades  Trade[]  @relation("tradeReceiverRooms")
}

model ChestType {
  id                  String                @id @default(cuid())
  name                String                @unique
  price               Int
  Chests              Chest[]
  ChestDropRate       ChestDropRate[]
  BundleTypeChestType BundleTypeChestType[]
}

model ChestDropRate {
  id          String    @id @default(cuid())
  chestType   ChestType @relation(fields: [chestTypeId], references: [id])
  chestTypeId String
  rarity      Rarity
  chance      Float // % of chance

  @@unique([chestTypeId, rarity])
}

model Chest {
  id              String    @id @default(cuid())
  type            ChestType @relation(fields: [chestTypeId], references: [id])
  User            User      @relation(fields: [userId], references: [id])
  userId          String
  opened          Boolean   @default(false)
  offeredInTrades Trade[]   @relation("tradeSenderChests")
  wantedInTrades  Trade[]   @relation("tradeReceiverChests")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  chestTypeId     String
}

model BundleType {
  id                  String                @id @default(cuid())
  name                String                @unique
  price               Float // Price in real dollars
  coinAmount          Int
  Bundle              Bundle[]
  BundleTypeChestType BundleTypeChestType[]
}

model BundleTypeChestType {
  id String @id @default(cuid())

  Bundle       BundleType @relation(fields: [bundleTypeId], references: [id])
  bundleTypeId String
  ChestType    ChestType  @relation(fields: [chestTypeId], references: [id])
  chestTypeId  String
  amount       Int //amount of chests being stored

  @@unique([bundleTypeId, chestTypeId])
}

model Bundle {
  id           String     @id @default(cuid())
  type         BundleType @relation(fields: [bundleTypeId], references: [id])
  User         User       @relation(fields: [userId], references: [id])
  bundleTypeId String
  userId       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Trade {
  id String @id @default(cuid())

  sender        User        @relation("sender", fields: [senderId], references: [id])
  senderId      String      @map("userAId")
  receiver      User        @relation("receiver", fields: [receiverId], references: [id])
  receiverId    String
  offeredRooms  UserRoom[]  @relation("tradeSenderRooms")
  wantedRooms   UserRoom[]  @relation("tradeReceiverRooms")
  offeredChests Chest[]     @relation("tradeSenderChests")
  wantedChests  Chest[]     @relation("tradeReceiverChests")
  status        TradeStatus @default(PENDING)
}

model CoinTransaction {
  id              String              @id @default(cuid())
  user            User                @relation(fields: [userId], references: [id])
  userId          String
  amount          Int
  type            CoinTransactionType
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  UserCoinPackage UserCoinPackage[]
}

model FriendInvite {
  id        String @id @default(cuid())
  inviter   User   @relation("inviter", fields: [inviterId], references: [id])
  inviterId String
  invitee   User   @relation("invitee", fields: [userId], references: [id])
  userId    String @unique
  code      String @unique
}

model Notification {
  id        String           @id @default(cuid())
  user      User             @relation(fields: [userId], references: [id])
  userId    String
  message   String
  url       String?
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime
  updatedAt DateTime         @updatedAt
}

model UserCoinPackage {
  id String @id @default(cuid())

  user              User            @relation(fields: [userId], references: [id])
  userId            String
  package           CoinPackage     @relation(fields: [coinPackageId], references: [id])
  coinPackageId     String
  transaction       CoinTransaction @relation(fields: [coinTransactionId], references: [id])
  coinTransactionId String
}

model CoinPackage {
  id              String            @id @default(cuid())
  price           Int
  baseCoins       Int
  bonusCoins      Int
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  UserCoinPackage UserCoinPackage[]
}

model Achievement {
  id    String           @id @default(cuid())
  type  AchievementTypes
  users User[]
}

enum NotificationType {
  SYSTEM
  FRIEND_REQUEST
  TRADE_INVITE
}

enum TradeStatus {
  PENDING
  COMPLETED
  REJECTED
}

enum AchievementTypes {
  LEGENDARY_ROOMS
  FULL_CATEGORIES
  WEEK_ACTIVE
}

enum CoinTransactionType {
  PURCHASE
  REWARD
  GIFT
  OPEN_CHEST
}

enum Rarity {
  UNCOMMON
  COMMON
  RARE
  EPIC
  LEGENDARY
  SECRET
}

enum RoomCategory {
  ZEN
  NEON
  MYSTIC
  VOID
  RAIN
  INFERNO
  COSMIC
  URBAN
  SANCTUM
  ASCENSION
  SECRET
  ANIME
}
